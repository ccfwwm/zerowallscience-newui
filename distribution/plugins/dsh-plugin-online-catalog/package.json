{
  "name": "@zerowall/dsh-plugin-online-catalog",
  "version": "0.1.1",
  "description": "Install plugins and skills from live ZeroWall catalogs without replacing the desktop application.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./types": {
      "types": "./lib/types/shared/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "dsh.bundle.patch.yml",
    "zerowall.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "zerowall": {
    "profiles": [
      "stable",
      "development"
    ],
    "build": {
      "host": "src/host/index.ts",
      "client": "src/client/index.ts",
      "shared": {
        "types": "src/shared/types.ts"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3",
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@zerowall/dsh-plugin-skills": "0.1.3",
    "react": "18.3.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@zerowall/dsh-plugin-skills": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.1",
    "typescript": "6.0.3",
    "react": "18.3.1",
    "@types/react": "18.3.31",
    "vitest": "^4.1.10",
    "esbuild": "0.27.7",
    "@testing-library/react": "^16.3.3",
    "jsdom": "29.1.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "@types/semver": "^7.7.0",
    "jszip": "3.10.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  }
}
